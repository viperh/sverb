#!/usr/bin/env python3
"""M1-18: a tiny HTTP echo service for port-forwarding tests.

GET/POST/... any path: answers 200 with a body of the form
    echo <METHOD> <PATH>\n<request body>
Usage: sverb-http-echo <port>   (binds 0.0.0.0)
"""
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


class Echo(BaseHTTPRequestHandler):
    def _answer(self):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b""
        out = f"echo {self.command} {self.path}\n".encode() + body
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(out)))
        self.end_headers()
        self.wfile.write(out)

    do_GET = do_POST = do_PUT = do_DELETE = do_HEAD = _answer

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8080
    ThreadingHTTPServer(("0.0.0.0", port), Echo).serve_forever()
