#!/bin/bash
# M1-18: the scripted "OTP module" of the `kbd` profile (run by pam_exec with
# expose_authtok: the answer arrives on stdin, NUL-terminated). Accepts only the
# fixed test code 424242, for the image's users.
code=""
IFS= read -r -d '' code || true
case "${PAM_USER:-}" in
    test | testzsh | testfish) ;;
    *) exit 1 ;;
esac
[[ "$code" == "424242" ]]
