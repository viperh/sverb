# Used by direnv (https://direnv.net) to keep config, data, logs and the agent
# socket inside the repo while developing instead of scattering them across the
# user's system. SVERB_HOME relocates every sverb directory (SPEC §5.1):
# .sverb-home/{config,data,state,run}.
export SVERB_HOME="$(pwd)/.sverb-home"
export SVERB_LOG=debug
